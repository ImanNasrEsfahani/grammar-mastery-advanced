# Server-only secrets and tunable runtime values for grammar-mastery-advanced.
# Copy this file to .env.docker on the server and replace CHANGE_ME values.

DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_50_CHARACTERS

POSTGRES_DB=grammar_mastery
POSTGRES_USER=grammar_mastery
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

STAGE21_JWT_SIGNING_KEY=CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_JWT_SIGNING_KEY
STAGE21_JWT_KEY_ID=primary-v1
STAGE21_JWT_PREVIOUS_SIGNING_KEY=
STAGE21_JWT_PREVIOUS_KEY_ID=

DJANGO_DB_SSLMODE=prefer
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

STAGE21_JWT_ACCESS_TTL_SECONDS=86400
STAGE21_SESSION_TTL_SECONDS=2592000
STAGE21_SESSION_TOUCH_INTERVAL_SECONDS=600

DEFAULT_FROM_EMAIL=noreply@grammarb2.imannasr.com
LOG_LEVEL=INFO
PERF_LOG_LEVEL=INFO
