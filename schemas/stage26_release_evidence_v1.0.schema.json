{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage26_release_evidence_v1.0.schema.json",
  "title": "Grammar Mastery Advanced Seed Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "target_environment",
    "release_mode",
    "ci",
    "migrations",
    "content",
    "release_note"
  ],
  "properties": {
    "schema_version": {
      "const": "advanced-seed-release-evidence-v1.0.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 3
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "release_mode": {
      "enum": [
        "SCHEMA_ONLY",
        "FULL_PRODUCT"
      ]
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "python_compile",
        "frontend_validate"
      ],
      "properties": {
        "boundary": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "python_compile": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "frontend_validate": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_version",
        "dry_run",
        "applied",
        "canonical_data_applied"
      ],
      "properties": {
        "plan_version": {
          "const": "advanced-schema-sequence-v1.0.0"
        },
        "dry_run": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "applied": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "canonical_data_applied": {
          "const": false
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ADVANCED_CANONICAL_CONTENT_EMPTY",
            "ADVANCED_CANONICAL_CONTENT_FROZEN"
          ]
        }
      }
    },
    "release_note": {
      "type": "string",
      "minLength": 3
    }
  }
}
